{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "description": "sb-rust's dependency updates (ADR-026): patch updates of ordinary crates automerge once CI passes; minor and major updates, the exact pins (ADR-001), the toolchain, the build image and every value outside Cargo always open a PR for review.",
    "extends": [
        "config:recommended",
        "helpers:pinGitHubActionDigests",
        ":semanticCommits",
        ":separateMajorReleases",
        ":ignoreUnstable",
        "schedule:weekly"
    ],
    "prConcurrentLimit": 0,
    "prHourlyLimit": 0,
    "labels": [
        "dependencies"
    ],
    "platformAutomerge": false,
    "vulnerabilityAlerts": {
        "enabled": true,
        "schedule": [
            "at any time"
        ],
        "addLabels": [
            "security",
            "vulnerability"
        ]
    },
    "commitMessageAction": "Update",
    "commitMessageTopic": "{{depName}}",
    "commitMessageExtra": "to {{newVersion}}",
    "prBodyTemplate": "{{{header}}}{{{table}}}{{{notes}}}{{{changelogs}}}{{{configDescription}}}{{{controls}}}{{{footer}}}",
    "lockFileMaintenance": {
        "enabled": true
    },
    "packageRules": [
        {
            "description": "Docker images aren't pinned to digests (sb-go's choice), but for the release build image below",
            "matchCategories": [
                "docker"
            ],
            "pinDigests": false
        },
        {
            "description": "Rust crates: patch updates, grouped, automerged when CI (scripts/check.sh task) passes",
            "matchManagers": [
                "cargo"
            ],
            "matchUpdateTypes": [
                "patch"
            ],
            "groupName": "rust crates (patch)",
            "automerge": true,
            "automergeType": "pr",
            "labels": [
                "dependencies",
                "rust"
            ]
        },
        {
            "description": "Rust crates: minor updates, grouped, a PR for review",
            "matchManagers": [
                "cargo"
            ],
            "matchUpdateTypes": [
                "minor"
            ],
            "groupName": "rust crates (minor)",
            "automerge": false,
            "labels": [
                "dependencies",
                "rust"
            ]
        },
        {
            "description": "Rust crates: major updates, one PR each, for review",
            "matchManagers": [
                "cargo"
            ],
            "matchUpdateTypes": [
                "major"
            ],
            "automerge": false,
            "labels": [
                "dependencies",
                "rust",
                "major"
            ]
        },
        {
            "description": "clap_complete and bollard, exact pins (ADR-001; docker spec, \"API version\"): each moves only in its own reviewed PR, with ADR-001's procedure; never grouped, never automerged, the = kept",
            "matchManagers": [
                "cargo"
            ],
            "matchPackageNames": [
                "clap_complete",
                "bollard"
            ],
            "groupName": null,
            "automerge": false,
            "labels": [
                "dependencies",
                "rust",
                "exact-pin"
            ]
        },
        {
            "description": "ratatui and ratatui-core, exact pins (ADR-001): each ratatui release needs its own ratatui-core, so they move together in one reviewed PR; never automerged, the = kept",
            "matchManagers": [
                "cargo"
            ],
            "matchPackageNames": [
                "ratatui",
                "ratatui-core"
            ],
            "groupName": "ratatui (exact pins)",
            "automerge": false,
            "labels": [
                "dependencies",
                "rust",
                "exact-pin"
            ]
        },
        {
            "description": "The Rust toolchain (rust-toolchain.toml): a pin CONSTRAINTS.md moves only with an ADR; a PR for review, never automerged",
            "matchDepNames": [
                "rust"
            ],
            "automerge": false,
            "labels": [
                "dependencies",
                "toolchain"
            ],
            "matchManagers": [
                "rust-toolchain"
            ]
        },
        {
            "description": "The release build image (build/Dockerfile, ADR-020): pinned to its digest, which is then followed; a PR for review, never automerged, never grouped",
            "matchFileNames": [
                "build/Dockerfile"
            ],
            "matchDatasources": [
                "docker"
            ],
            "pinDigests": true,
            "groupName": null,
            "automerge": false,
            "labels": [
                "dependencies",
                "build-image"
            ]
        },
        {
            "description": "The release build image's tag never moves: it is the oldest supported release (ADR-020)",
            "matchFileNames": [
                "build/Dockerfile"
            ],
            "matchDatasources": [
                "docker"
            ],
            "matchUpdateTypes": [
                "major",
                "minor",
                "patch",
                "replacement"
            ],
            "enabled": false
        },
        {
            "description": "Values outside Cargo (uv, the gate's tools, Speedtest): each a PR for review, never automerged",
            "matchManagers": [
                "custom.regex"
            ],
            "automerge": false,
            "labels": [
                "dependencies",
                "pinned-value"
            ]
        },
        {
            "description": "Speedtest: Renovate can't update the archives' sizes and SHA-256 digests with the version, so its PR waits for approval on the dependency dashboard and is finished by hand (crates/ops/src/bench/speedtest.rs)",
            "matchDepNames": [
                "ookla-speedtest"
            ],
            "dependencyDashboardApproval": true
        },
        {
            "description": "gitleaks: its version and both archives' pinned SHA-256s (scripts/install-gitleaks.sh, CONSTRAINTS.md's Tools row) in one PR, proposed once the release is 7 days old, which waits for the maintainer's approval on the dependency dashboard; before merging it, check each new SHA-256 as scripts/install-gitleaks.sh says",
            "matchPackageNames": [
                "gitleaks/gitleaks"
            ],
            "groupName": "gitleaks",
            "minimumReleaseAge": "7 days",
            "dependencyDashboardApproval": true
        },
        {
            "description": "The gate's tools: each its own PR, as CONSTRAINTS.md's Tools table pins each exactly (gitleaks' install script beside its row)",
            "matchFileNames": [
                "CONSTRAINTS.md",
                "scripts/install-gitleaks.sh"
            ],
            "automerge": false,
            "labels": [
                "dependencies",
                "gate-tools"
            ]
        },
        {
            "description": "diff-cover's lock is pip-compile's to regenerate, hashes and all: pip_requirements, which matches any requirements.txt, would bump a pin without them",
            "matchManagers": [
                "pip_requirements"
            ],
            "matchFileNames": [
                "scripts/diff-cover/requirements.txt"
            ],
            "enabled": false
        },
        {
            "description": "diff-cover: its lock (pip-compile) and CONSTRAINTS.md's Tools row (custom.regex) move together, in one PR for review",
            "matchPackageNames": [
                "diff-cover"
            ],
            "groupName": "diff-cover",
            "automerge": false
        },
        {
            "description": "check-jsonschema's lock is pip-compile's to regenerate, hashes and all, as diff-cover's",
            "matchManagers": [
                "pip_requirements"
            ],
            "matchFileNames": [
                "scripts/check-jsonschema/requirements.txt"
            ],
            "enabled": false
        },
        {
            "description": "check-jsonschema: its lock (pip-compile) and CONSTRAINTS.md's Tools row (custom.regex) move together, in one PR for review",
            "matchPackageNames": [
                "check-jsonschema"
            ],
            "groupName": "check-jsonschema",
            "automerge": false
        },
        {
            "description": "The Python actions/setup-python provides (ci.yml, release.yml) is check-jsonschema's, also named by scripts/install-check-jsonschema.sh (`--python 3.12`) and its lock's header (`--python-version=3.12`): it moves by hand with them, never alone; setup-python takes the newest 3.12 patch release on each run",
            "matchManagers": [
                "github-actions"
            ],
            "matchDepNames": [
                "python"
            ],
            "enabled": false
        },
        {
            "description": "GitHub Actions: minor and patch updates, grouped (sb-go's)",
            "matchManagers": [
                "github-actions"
            ],
            "groupName": "github-actions",
            "matchUpdateTypes": [
                "minor",
                "patch"
            ],
            "labels": [
                "dependencies",
                "github-actions"
            ]
        },
        {
            "description": "GitHub Actions: major updates (sb-go's)",
            "matchManagers": [
                "github-actions"
            ],
            "matchUpdateTypes": [
                "major"
            ],
            "labels": [
                "dependencies",
                "github-actions",
                "major"
            ]
        },
        {
            "description": "saltyorg's own actions stay on their published version tags, never digests (the maintainer's consumer rule; .github/zizmor.yml allows them)",
            "matchManagers": [
                "github-actions"
            ],
            "matchPackageNames": [
                "saltyorg/**"
            ],
            "pinDigests": false
        }
    ],
    "pip-compile": {
        "description": "The gate's hash-pinned Python locks, each compiled by uv from its requirements.in and installed with --require-hashes: diff-cover's (scripts/install-diff-cover.sh) and check-jsonschema's (scripts/install-check-jsonschema.sh)",
        "managerFilePatterns": [
            "/(^|/)scripts/diff-cover/requirements\\.txt$/",
            "/(^|/)scripts/check-jsonschema/requirements\\.txt$/"
        ]
    },
    "customManagers": [
        {
            "customType": "regex",
            "description": "The uv sb installs (crates/cli-core/src/build_info.rs, as sb-go's buildinfo), the same uv in the workflows' install-action tool lists, which installs diff-cover and check-jsonschema, and the uv source link in scripts/install-check-jsonschema.sh",
            "managerFilePatterns": [
                "/(^|/)crates/cli-core/src/build_info\\.rs$/",
                "/(^|/)\\.github/workflows/[^/]+\\.yml$/",
                "/(^|/)scripts/install-check-jsonschema\\.sh$/"
            ],
            "matchStrings": [
                "pub const UV_VERSION: &str = \"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\";",
                "[,:\\s]uv@(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\\b",
                "github\\.com/astral-sh/uv/blob/(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)/"
            ],
            "depNameTemplate": "uv",
            "datasourceTemplate": "pypi",
            "versioningTemplate": "pep440"
        },
        {
            "customType": "regex",
            "description": "Speedtest's version in Ookla's download URLs (crates/ops/src/bench/speedtest.rs); the sizes and digests beside them are updated by hand",
            "managerFilePatterns": [
                "/(^|/)crates/ops/src/bench/speedtest\\.rs$/"
            ],
            "matchStrings": [
                "https://install\\.speedtest\\.net/app/cli/ookla-speedtest-(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)-linux-x86_64\\.tgz",
                "https://install\\.speedtest\\.net/app/cli/ookla-speedtest-(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)-linux-aarch64\\.tgz"
            ],
            "depNameTemplate": "ookla-speedtest",
            "datasourceTemplate": "custom.ookla-speedtest",
            "versioningTemplate": "semver",
            "extractVersionTemplate": "ookla-speedtest-(?<version>[0-9]+\\.[0-9]+\\.[0-9]+)-linux-x86_64\\.tgz$"
        },
        {
            "customType": "regex",
            "description": "The gate's cargo-installed tools (CONSTRAINTS.md's Tools table, exact versions; the workflows' install-action tool lists and their cargo install lines). Under install-action's `fallback: none` (ci.yml), a version newer than the pinned install-action's manifest fails CI until that action's own update lands; rebase the PR then",
            "managerFilePatterns": [
                "/(^|/)CONSTRAINTS\\.md$/",
                "/(^|/)\\.github/workflows/[^/]+\\.yml$/"
            ],
            "matchStrings": [
                "\\| (?<depName>cargo-llvm-cov|cargo-mutants|cargo-nextest|cargo-deny|hyperfine) \\| (?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+) \\| exact \\|",
                "\\| (?<depName>cross) \\| (?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+) \\| exact \\|",
                "\\b(?<depName>cargo-llvm-cov|cargo-mutants|cargo-nextest|cargo-deny|hyperfine|cross)@(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\\b",
                "cargo install --locked (?<depName>cargo-mutants|cross) --version (?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
            ],
            "datasourceTemplate": "crate",
            "versioningTemplate": "semver"
        },
        {
            "customType": "regex",
            "description": "diff-cover (CONSTRAINTS.md's Tools table: its version and its install line; its lock is the pip-compile manager's)",
            "managerFilePatterns": [
                "/(^|/)CONSTRAINTS\\.md$/"
            ],
            "matchStrings": [
                "\\| diff-cover \\| (?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+) \\| exact \\|",
                "installs `diff-cover==(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)`"
            ],
            "depNameTemplate": "diff-cover",
            "datasourceTemplate": "pypi",
            "versioningTemplate": "pep440"
        },
        {
            "customType": "regex",
            "description": "gitleaks' version (CONSTRAINTS.md's Tools table; scripts/install-gitleaks.sh's GITLEAKS_VERSION, the release it downloads)",
            "managerFilePatterns": [
                "/(^|/)CONSTRAINTS\\.md$/",
                "/(^|/)scripts/install-gitleaks\\.sh$/"
            ],
            "matchStrings": [
                "\\| gitleaks \\| (?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+) \\| exact \\|",
                "\\nGITLEAKS_VERSION=(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\\n"
            ],
            "depNameTemplate": "gitleaks",
            "packageNameTemplate": "gitleaks/gitleaks",
            "datasourceTemplate": "github-releases",
            "extractVersionTemplate": "^v(?<version>.*)$",
            "versioningTemplate": "semver"
        },
        {
            "customType": "regex",
            "description": "gitleaks' pins (scripts/install-gitleaks.sh): each archive's release tag and SHA-256, the digest taken from the same archive's line in the new release's checksums file (github-release-attachments reads the release by its tag, so the pin keeps the tag's v)",
            "managerFilePatterns": [
                "/(^|/)scripts/install-gitleaks\\.sh$/"
            ],
            "matchStrings": [
                "\\nGITLEAKS_PIN_LINUX_X64='(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+) (?<currentDigest>[0-9a-f]{64})'\\n",
                "\\nGITLEAKS_PIN_LINUX_ARM64='(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+) (?<currentDigest>[0-9a-f]{64})'\\n"
            ],
            "depNameTemplate": "gitleaks",
            "packageNameTemplate": "gitleaks/gitleaks",
            "datasourceTemplate": "github-release-attachments",
            "versioningTemplate": "semver"
        },
        {
            "customType": "regex",
            "description": "check-jsonschema (CONSTRAINTS.md's Tools table: its version and its install line; the docs links in check.sh and the schemas' tests; its lock is the pip-compile manager's)",
            "managerFilePatterns": [
                "/(^|/)CONSTRAINTS\\.md$/",
                "/(^|/)scripts/check\\.sh$/",
                "/(^|/)scripts/workflow-schemas\\.test\\.sh$/"
            ],
            "matchStrings": [
                "\\| check-jsonschema \\| (?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+) \\| exact \\|",
                "installs `check-jsonschema==(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)`",
                "github\\.com/python-jsonschema/check-jsonschema/blob/(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)/"
            ],
            "depNameTemplate": "check-jsonschema",
            "datasourceTemplate": "pypi",
            "versioningTemplate": "pep440"
        },
        {
            "customType": "regex",
            "description": "zizmor (CONSTRAINTS.md's Tools table: its version and its install line; the workflows' install-action tool lists). Under install-action's `fallback: none` (ci.yml), a version newer than the pinned install-action's manifest fails CI until that action's own update lands; rebase the PR then",
            "managerFilePatterns": [
                "/(^|/)CONSTRAINTS\\.md$/",
                "/(^|/)\\.github/workflows/[^/]+\\.yml$/"
            ],
            "matchStrings": [
                "\\| zizmor \\| (?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+) \\| exact \\|",
                "`uv tool install zizmor==(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)`",
                "\\bzizmor@(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\\b"
            ],
            "depNameTemplate": "zizmor",
            "datasourceTemplate": "pypi",
            "versioningTemplate": "pep440"
        }
    ],
    "customDatasources": {
        "ookla-speedtest": {
            "defaultRegistryUrlTemplate": "https://www.speedtest.net/apps/cli",
            "format": "html"
        }
    },
    "osvVulnerabilityAlerts": true
}
