# Saltbox MOTD Configuration
# All sections are disabled by default. Set enabled: true and fill in the values to use.

# Custom color scheme (all values are hex colors)
# These are the default values
colors:
  text:
    label: "#58A6FF"
    value: "#58A6FF"
    app_name: "#BC8CFF"
  status:
    warning: "#D29922"
    success: "#58A6FF"
    error: "#EC8E2C"
  progress_bar:
    low: "#58A6FF"
    high: "#D29922"
    critical: "#EC8E2C"

# Emby instances for streaming information
emby:
  enabled: false
  instances:
    - name: "Emby"
      url: "http://localhost:8096"
      token: "your-api-token-here"
      timeout: 0
      enabled: false

# Jellyfin instances for streaming information
jellyfin:
  enabled: false
  instances:
    - name: "Jellyfin"
      url: "http://localhost:8096"
      token: "your-api-token-here"
      timeout: 0
      enabled: false

# Lidarr instances for download queue information
lidarr:
  enabled: false
  instances:
    - name: "Lidarr"
      url: "http://localhost:8686"
      apikey: "your-api-key-here"
      timeout: 0
      enabled: false

# NZBGet instances for download information
nzbget:
  enabled: false
  instances:
    - name: "NZBGet"
      url: "http://localhost:6789"
      user: "your-username"
      password: "your-password"
      timeout: 0
      enabled: false

# Plex instances for streaming information
plex:
  enabled: false
  instances:
    - name: "Plex"
      url: "http://localhost:32400"
      token: "your-plex-token-here"
      timeout: 0
      enabled: false

# qBittorrent instances for torrent information
qbittorrent:
  enabled: false
  instances:
    - name: "qBittorrent"
      url: "http://localhost:8080"
      user: "your-username"
      password: "your-password"
      timeout: 0
      enabled: false

# Radarr instances for download queue information
radarr:
  enabled: false
  instances:
    - name: "Radarr"
      url: "http://localhost:7878"
      apikey: "your-api-key-here"
      timeout: 0
      enabled: false

# Readarr instances for download queue information
readarr:
  enabled: false
  instances:
    - name: "Readarr"
      url: "http://localhost:8787"
      apikey: "your-api-key-here"
      timeout: 0
      enabled: false

# rTorrent instances for torrent information
rtorrent:
  enabled: false
  instances:
    - name: "rTorrent"
      url: "http://localhost:8080"
      user: "your-username"
      password: "your-password"
      timeout: 0
      enabled: false

# SABnzbd instances for download information
sabnzbd:
  enabled: false
  instances:
    - name: "SABnzbd"
      url: "http://localhost:8080"
      apikey: "your-api-key-here"
      timeout: 0
      enabled: false

# Sonarr instances for download queue information
sonarr:
  enabled: false
  instances:
    - name: "Sonarr"
      url: "http://localhost:8989"
      apikey: "your-api-key-here"
      timeout: 0
      enabled: false

# Systemd services monitoring
systemd:
  enabled: false
  additional_services: []
  display_names: {}
