#!/bin/sh
# A stand-in for ansible-playbook in sb's tests (ansible spec, Testing
# strategy): it never runs Ansible. Each run writes one record,
# `$FAKE_ANSIBLE_LOG.<n>` (n = 0, 1, ... in run order): its working
# directory, then its $0 and each argument, every element followed by a
# NUL, so an element holding spaces, newlines or quotes is compared whole.
#
# Each setting comes from the environment, else from a file of that name in
# `.fake-ansible/` under its working directory (the repository it runs
# in): tests running in one process, whose environment their threads share,
# set it there, without writing a program to run.
#
#   FAKE_ANSIBLE_LOG     the record's prefix (`.fake-ansible/argv` when unset)
#   FAKE_ANSIBLE_EXIT    the exit code (0 when unset)
#   FAKE_ANSIBLE_MODE    `wait`: write the pid to `$FAKE_ANSIBLE_LOG.pid` and
#                        wait, with the signals at their defaults (a SIGINT
#                        kills it); a SIGTERM writes `$FAKE_ANSIBLE_LOG.term`
#                        and exits with FAKE_ANSIBLE_EXIT (143 when unset).
#                        `interrupt`: as `wait`, but a SIGINT prints Ansible's
#                        "User interrupted execution" and exits 99, as
#                        ansible-core's CLI does.
#                        `self-kill`: it kills itself with SIGKILL, as the OOM
#                        killer would, a signal sb never got.
#                        `sleep`: it sleeps FAKE_ANSIBLE_SLEEP seconds first.
#                        `after`: it waits until the file FAKE_ANSIBLE_AFTER
#                        is there (30 s at most) first.
#                        `meet`: it appends `start <dir>` to
#                        `$FAKE_ANSIBLE_MEET/log` (<dir> the last part of its
#                        working directory), marks itself started, waits
#                        until two runs have started or FAKE_ANSIBLE_TICKS
#                        times 0.05 s have passed (40 when unset), then
#                        appends `end <dir>`: two listings at once each see
#                        the other start; in turn, the first ends alone.
#   FAKE_ANSIBLE_LISTING printed to stdout when `--list-tags` is an argument
#                        (`.fake-ansible/FAKE_ANSIBLE_LISTING` keeps its
#                        escape codes and newlines, as a file)
#   FAKE_ANSIBLE_STDERR  printed to stderr before it ends
setting() {
  eval "value=\${$1-}"
  if [ -z "$value" ] && [ -f ".fake-ansible/$1" ]; then
    value=$(cat ".fake-ansible/$1")
  fi
  printf '%s' "$value"
}
log=$(setting FAKE_ANSIBLE_LOG)
log=${log:-.fake-ansible/argv}
mode=$(setting FAKE_ANSIBLE_MODE)
code=$(setting FAKE_ANSIBLE_EXIT)
# The record is written whole to a file of its own, then linked to the
# first free number (a hard link fails when the name is taken), so two
# runs at once (the tag listings) never take the same number, and a run
# stopped half-way leaves no partial record.
tmp="$log.tmp.$$"
printf '%s\0' "$PWD" "$0" "$@" > "$tmp"
n=0
while [ "$n" -lt 1000 ] && ! ln "$tmp" "$log.$n" 2>/dev/null; do n=$((n + 1)); done
rm -f "$tmp"
for arg; do
  if [ "$arg" = --list-tags ]; then
    if [ -n "${FAKE_ANSIBLE_LISTING-}" ]; then
      printf '%s\n' "$FAKE_ANSIBLE_LISTING"
    elif [ -f .fake-ansible/FAKE_ANSIBLE_LISTING ]; then
      cat .fake-ansible/FAKE_ANSIBLE_LISTING
    fi
  fi
done
stderr=$(setting FAKE_ANSIBLE_STDERR)
if [ -n "$stderr" ]; then printf '%s\n' "$stderr" >&2; fi
case "$mode" in
  wait|interrupt)
    trap 'echo term > "$log.term"; exit "${code:-143}"' TERM
    if [ "$mode" = interrupt ]; then
      trap 'echo "User interrupted execution" >&2; exit 99' INT
    fi
    echo $$ > "$log.pid.tmp" && mv "$log.pid.tmp" "$log.pid"
    while :; do sleep 0.05; done
    ;;
  self-kill)
    kill -KILL $$
    ;;
  sleep)
    sleep "$(setting FAKE_ANSIBLE_SLEEP)"
    ;;
  after)
    after=$(setting FAKE_ANSIBLE_AFTER)
    i=0
    while [ ! -e "$after" ] && [ "$i" -lt 600 ]; do sleep 0.05; i=$((i + 1)); done
    ;;
  meet)
    meet=$(setting FAKE_ANSIBLE_MEET)
    ticks=$(setting FAKE_ANSIBLE_TICKS)
    name=${PWD##*/}
    echo "start $name" >> "$meet/log"
    : > "$meet/$name.started"
    i=0
    while [ "$i" -lt "${ticks:-40}" ]; do
      set -- "$meet"/*.started
      [ $# -ge 2 ] && break
      sleep 0.05
      i=$((i + 1))
    done
    echo "end $name" >> "$meet/log"
    ;;
esac
exit "${code:-0}"
